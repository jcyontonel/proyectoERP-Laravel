APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Consulta de DNI/RUC (https://apiperu.dev). El token solo se usa en el servidor.
APIPERU_URL=https://api.apiperu.dev
APIPERU_TOKEN=
# Opcional: certificados raíz para HTTPS si PHP no los trae (XAMPP en Windows). Ej.: storage/certs/cacert.pem
APIPERU_CA_BUNDLE=

# Contextos (config/modulos.php). En desarrollo déjalos vacíos: cada uno usa su prefijo (/plataforma, /tienda, /api).
# En producción, cada uno en su subdominio y la tienda en el dominio principal, con los prefijos vacíos:
#   ERP_DOMINIO=erp.ricopet.com  ERP_PREFIJO=   PLATAFORMA_DOMINIO=admin.ricopet.com  PLATAFORMA_PREFIJO=
#   WEB_DOMINIO=ricopet.com   (y SESSION_DOMAIN=.ricopet.com para compartir la sesión)
# En desarrollo: la web pública en la raíz (/ y /{slug}) y el ERP en /erp.
ERP_DOMINIO=
PLATAFORMA_DOMINIO=
WEB_DOMINIO=
API_DOMINIO=

# API de administración (/api/admin) para clientes EXTERNOS. Las pantallas de /plataforma no la necesitan.
# Vacío = API cerrada. Genera uno largo, p. ej.: php -r "echo bin2hex(random_bytes(32));"
ERP_ADMIN_TOKEN=

# Suscripciones
SUSCRIPCION_DIAS_GRACIA=5
SUSCRIPCION_DIAS_AVISO=7
SUSCRIPCION_SIN_PLAN_ILIMITADO=true

# Facturación electrónica (módulo Facturacion: Greenter directo a SUNAT). Cada empresa configura su modo,
# usuario SOL y certificado en Configuración → SUNAT. El envío va en cola: corre "php artisan schedule:work".
FACTURACION_ACTIVA=true
FACTURACION_ENVIO=cola
# Certificados raíz para HTTPS hacia SUNAT (XAMPP en Windows / antivirus que intercepta HTTPS)
FACTURADOR_CA_BUNDLE=storage/certs/cacert.pem

# Culqi (pago con tarjeta en las tiendas): llaves DE PRUEBA de la plataforma (pk_test_/sk_test_) para las tiendas
# en modo prueba que aún no cargan las suyas. Las de producción las pone cada tienda (el dinero es de la empresa).
CULQI_LLAVE_PUBLICA=
CULQI_LLAVE_SECRETA=

# Empresa del ERP que emite la factura/boleta de cada pago de suscripción (vacío = sin comprobante)
SUSCRIPCIONES_EMISOR_RUC=
SUSCRIPCIONES_EMISOR_EMPRESA_ID=
SUSCRIPCIONES_PRECIOS_INCLUYEN_IGV=true
